{
	"servers": {
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/"
		},
		"com.atlassian/atlassian-mcp-server": {
			"type": "http",
			"url": "https://mcp.atlassian.com/v1/mcp",
			"gallery": "https://api.mcp.github.com",
			"version": "1.1.1"
		},
		"obsidian": {
			"command": "uvx",
			"args": [
				"mcp-obsidian"
			],
			"env": {
				"OBSIDIAN_API_KEY": "${input:obsidian_api_key}"
			}
		}
	},
	"inputs": [
		{
			"id": "obsidian_api_key",
			"type": "promptString",
			"description": "Obsidian Local REST API key",
			"password": true
		}
	]
}
